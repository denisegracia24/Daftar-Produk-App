<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="850.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0" spacing="20.0">
         <children>
            <Label text="Aplikasi Daftar Produk Toko" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <VBox prefHeight="510.0" prefWidth="790.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Daftar Produk Tersedia">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtCari" promptText="Cari produk..." prefWidth="200.0" />
                  <Button mnemonicParsing="false" onAction="#handleCari" text="Cari" />
               </children>
            </HBox>
            <TableView fx:id="tabelProduk" prefHeight="330.0" prefWidth="740.0">
              <columns>
                <TableColumn fx:id="colKode" prefWidth="120.0" text="Kode Produk" />
                <TableColumn fx:id="colNama" prefWidth="240.0" text="Nama Produk" />
                <TableColumn fx:id="colKategori" prefWidth="180.0" text="Kategori" />
                <TableColumn fx:id="colHarga" prefWidth="200.0" text="Harga (Rp)" />
              </columns>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleHapus" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Hapus" />
                  <Button mnemonicParsing="false" onAction="#handleLihatDetail" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Lihat Detail" />
                  <Button mnemonicParsing="false" onAction="#handleTambahBaru" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Tambah Produk" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>